TRANSPORT_CRYPTO_LEGACY_KEY_PAIRS = '[]'
# 公钥缓存有效期（秒）
TRANSPORT_CRYPTO_PUBLIC_KEY_TTL_SECONDS = 3600
# 前端传输加密策略缓存有效期（秒）
TRANSPORT_CRYPTO_FRONTEND_CONFIG_TTL_SECONDS = 300
# GET/DELETE 请求参数加密后的最大 URL 长度
TRANSPORT_CRYPTO_MAX_GET_URL_LENGTH = 4096
# 请求时间窗允许偏差（秒）
TRANSPORT_CRYPTO_CLOCK_SKEW_SECONDS = 120
# 防重放随机数有效期（秒）
TRANSPORT_CRYPTO_REPLAY_TTL_SECONDS = 300
# 启用传输层加密的路径列表，多个值使用逗号分隔，留空表示默认全部启用
TRANSPORT_CRYPTO_ENABLED_PATHS = ''
# 强制要求传输层加密的路径列表，多个值使用逗号分隔
TRANSPORT_CRYPTO_REQUIRED_PATHS = ''
# 排除传输层加密的路径列表，多个值使用逗号分隔
TRANSPORT_CRYPTO_EXCLUDE_PATHS = '/openapi.json,/docs,/docs/oauth2-redirect,/redoc,/transport/crypto/frontend-config,/transport/crypto/public-key,/common/download,/common/download/resource'

# ================ MineU ================ 
# MineU 本地文件批量上传解析url
mineru_url = 'https://mineru.net'
mineru_file_urls_uri = '/api/v4/file-urls/batch'
mineru_extract_results_uri = '/api/v4/extract-results/batch'
# MinerU 本地文件批量上传解析token
mineru_token = 'eyJ0eXBlIjoiSldUIiwiYWxnIjoiSFM1MTIifQ.eyJqdGkiOiIzMTEwMDkxMyIsInJvbCI6IlJPTEVfUkVHSVNURVIiLCJpc3MiOiJPcGVuWExhYiIsImlhdCI6MTc4MDQ2OTc4MywiY2xpZW50SWQiOiJsa3pkeDU3bnZ5MjJqa3BxOXgydyIsInBob25lIjoiIiwib3BlbklkIjpudWxsLCJ1dWlkIjoiN2Q1MzFiMzktY2JiOC00MDRkLWFiM2YtNDQ0ZDk3ZDU0ODgxIiwiZW1haWwiOiIiLCJleHAiOjE3ODgyNDU3ODN9.-GCgSvMnQS9qrJwRhFxYuPbdWM0Y_9x1q1bVaPTxqvh3EXUHp8131q052RXrnrlc0CJvRUlx1K6f0Z6g7rNjOw'
# mineru模型版本，三个选项:pipeline、vlm、MinerU-HTML，默认pipeline
mineru_model_version = 'vlm'
mineru_html_model_version = 'MinerU-HTML'
# MineU 解析结果回调通知回调地址
mineru_callback_url = ''
# 随机字符串，该值用于回调通知请求中的签名。用于在接收到内容安全的回调通知时校验请求由 Mineru 解析服务发起
mineru_seed = ''

# ================ crawl4ai 爬取引擎配置 ================ 
# ---------- 模式切换 ----------
# 调用模式：sdk（本地SDK，进程内调用）或 service（远程服务，HTTP调用Docker部署的crawl4ai）
crawl4ai_mode = 'sdk'
# 远程服务地址（service 模式必填，Docker 默认端口 11235）
crawl4ai_service_url = 'http://localhost:11235'
# 远程服务认证 Token（对应 Docker 部署的 CRAWL4AI_API_TOKEN，0.9.0+ 默认开启认证）
crawl4ai_api_token = ''
# HTTP 请求超时秒数（service 模式，爬取大站时可能需要较长超时）
crawl4ai_request_timeout = 300

# ---------- BrowserConfig 相关（sdk 模式 + service 模式共用） ----------
# 无头浏览器模式
crawl4ai_headless = true
# 浏览器 User-Agent
crawl4ai_user_agent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
# 视口宽度（标准桌面，避免移动端布局）
crawl4ai_viewport_width = 1920
# 视口高度
crawl4ai_viewport_height = 1080
# 基础反爬防御，无副作用，始终开启
crawl4ai_enable_stealth = true
# 生产环境关闭 crawl4ai 内部日志，保持日志干净
crawl4ai_verbose = false

# ---------- CrawlerRunConfig 相关 ----------
# 始终排除的噪音标签，确保 Markdown 输出干净（多个值使用逗号分隔）
crawl4ai_excluded_tags = 'nav,footer,header,aside,script,style,form,iframe'
# 保留结构化输出，不提取纯文本
crawl4ai_only_text = false
# 过滤零碎内容块（少于此词数的块丢弃）
crawl4ai_word_count_threshold = 10
# 深度爬取时流式返回结果，边爬边处理
crawl4ai_stream = true

# ---------- 任务级并发控制 ----------
# 全局最大并发爬取任务数（基于 Redis BLPOP 的分布式信号量）
# 多 worker 环境下统一限制并发爬取任务数
# 已在 SemaphoreConfig 中替代，见下方"分布式信号量配置"段
# crawl4ai_max_concurrent_tasks = 10

# ---------- 任务超时控制 ----------
# 爬取任务超时阈值（分钟），超过此时间 RUNNING 状态的任务将被定时任务标记为 FAILED
# 同时设置 Redis 取消标志通知正在执行的爬取协程主动停止
crawl4ai_task_timeout_minutes = 60

# ---------- 失败重试控制 ----------
# 规则自动重试次数上限（针对瞬时故障类错误码：浏览器崩溃、页面超时、连接重置、429限速、Cloudflare挑战）
# 超过后升级为用户人工决策，用户可在聊天框通过 Agent 调整策略配置后重试
crawl4ai_rule_retry_limit = 2

# ================ 网页爬取 Agent 配置 ================
# ReAct 分析阶段最大轮次，达到上限后 LLM 停止工具调用
# CRAWLER_AGENT_MAX_REACT_ROUNDS = 8
# URL 路由中断类型标识（用户确认网站切换/分析操作）
# INTERRUPT_URL_ROUTER_DECISION = 'url_router_decision'
# 用户提问中断类型标识（Agent 向用户发起业务提问）
# INTERRUPT_ASK_USER = 'ask_user'
# 策略确认中断类型标识（用户确认/修改爬取策略配置）
# INTERRUPT_STRATEGY_CONFIRMATION = 'strategy_confirmation'

# ================ 模型功能适配配置 ================
# 爬取Agent功能适配参数ID
CRAWLER_AGENT_PARAM_ID = 'web_crawler_agent'
# Markdown图片描述生成功能适配参数ID
MD_IMAGE_DESCRIPTION_PARAM_ID = 'md_image_description'
# TXT转Markdown功能适配参数ID
TXT_TO_MARKDOWN_PARAM_ID = 'txt_to_markdown'

# ================ minio ================ 
# MinIO 服务地址，指向宿主机已运行的 MinIO（端口 9000 为 S3 API 端口）
minio_address = 'http://localhost:9000'
# MinIO 访问密钥 ID（用户自定义账号）
minio_access_key_id = 'jiangwch'
# MinIO 秘密访问密钥（用户自定义密码）
minio_secret_access_key = 'jiangwch'
# 是否使用 SSL/TLS 加密连接，false 表示使用明文 HTTP
minio_use_ssl = 'false'
# Milvus 专用的存储 bucket 名称（需预先在 MinIO 中创建）
milvus_bucket_name = milvus-data
# 知识库专用的存储 bucket 名称（需预先在 MinIO 中创建）
knowledge_bucket_name = knowledge-data
# MinIO 对象路径前缀：原始文档
MINIO_OBJECT_DOCUMENT_PREFIX = documents
# MinIO 对象路径前缀：文档中的图片
MINIO_OBJECT_IMAGE_PREFIX = documents/images
# MinIO 对象路径前缀：合并后的 Markdown
MINIO_OBJECT_MARKDOWN_PREFIX = documents/markdown
# MinIO 本地下载子目录（拼接在 DOWNLOAD_PATH 后）
MINIO_DOWNLOAD_SUBDIR = minio

# ================ Milvus ================
# Milvus 服务地址
milvus_uri = 'http://localhost:19530'
# 鉴权 token（username:password）；无鉴权留空
milvus_token = 'jiangwch:jiangwch'
# 数据库名
milvus_db = 'knowledge_rag'
# 文档向量 collection（DDL：sql/milvus/manage_document_vector.py）
document_vector_collection = 'knowledge_document_vector'

# ============ 消息流服务配置 ============
# 后端选择：redis(默认,使用 Redis Stream) / kafka(使用 confluent-kafka)
MESSAGE_STREAM_BACKEND = 'redis'

# ------------ 跨后端公共消费参数 ------------
# 消费者阻塞等待新消息的最大时长（毫秒），超时后返回空批次继续下一轮轮询
MESSAGE_STREAM_CONSUME_BLOCK_MS = 2000
# 单次拉取的最大消息条数
MESSAGE_STREAM_CONSUME_BATCH_SIZE = 100
# 消息空闲超过此时长（毫秒）视为 pending 可被其他消费者 claim（故障转移）
MESSAGE_STREAM_CLAIM_IDLE_MS = 60000
# 执行 pending claim 扫描的间隔（毫秒）
MESSAGE_STREAM_CLAIM_INTERVAL_MS = 5000

# ------------ Redis 后端专属 ------------
# Stream 近似裁剪上限（MAXLEN ~），超出时自动淘汰旧消息
MESSAGE_STREAM_REDIS_MAXLEN = 100000

# ================ Kafka 后端专属（切换为 kafka 时填写） ================
# Broker 地址列表，多个用逗号分隔
MESSAGE_STREAM_KAFKA_BOOTSTRAP_SERVERS = 'localhost:9092'
# 客户端标识，用于 Broker 日志追踪
MESSAGE_STREAM_KAFKA_CLIENT_ID = 'knowledge-content'
# 安全协议：PLAINTEXT / SSL / SASL_PLAINTEXT / SASL_SSL
MESSAGE_STREAM_KAFKA_SECURITY_PROTOCOL = 'PLAINTEXT'
# SASL 认证机制（如 PLAIN、SCRAM-SHA-256），不启用时留空
MESSAGE_STREAM_KAFKA_SASL_MECHANISM = ''
MESSAGE_STREAM_KAFKA_SASL_USERNAME = ''
MESSAGE_STREAM_KAFKA_SASL_PASSWORD = ''
# 生产者 acks 策略：0(不等待) / 1(Leader确认) / all(ISR全部确认)
MESSAGE_STREAM_KAFKA_ACKS = 'all'
# 生产者批量延迟发送等待时长（毫秒），增大可提升吞吐
MESSAGE_STREAM_KAFKA_LINGER_MS = 5
# 生产者请求超时时间（毫秒）
MESSAGE_STREAM_KAFKA_REQUEST_TIMEOUT_MS = 30000
# 消费者会话超时（毫秒），超过此时长无心跳则触发 Rebalance
MESSAGE_STREAM_KAFKA_SESSION_TIMEOUT_MS = 10000
# 消费者心跳间隔（毫秒），建议 <= session_timeout / 3
MESSAGE_STREAM_KAFKA_HEARTBEAT_INTERVAL_MS = 3000
# 消费者首次加入或 offset 失效时的重置策略：earliest / latest
MESSAGE_STREAM_KAFKA_AUTO_OFFSET_RESET = 'earliest'
# 自动创建 Topic 时的分区数
MESSAGE_STREAM_KAFKA_CREATE_TOPIC_PARTITIONS = 1
# 自动创建 Topic 时的副本因子（不应超过 Broker 数量）
MESSAGE_STREAM_KAFKA_CREATE_TOPIC_REPLICATION_FACTOR = 1

# ================ 上传下载文件配置 ================ 
# 上传文件URL前缀
UPLOAD_PREFIX = '/profile'
# 上传文件存放的本地根目录
UPLOAD_PATH = 'vf_admin/upload_path'
# 上传文件机器标识（用于文件名去重）
UPLOAD_MACHINE = 'A'
# 上传文件最大大小（字节），默认 100MB
UPLOAD_MAX_SIZE = 104857600
# 允许上传的文件扩展名列表（JSON数组格式），如需覆盖默认值可取消注释
DEFAULT_ALLOWED_EXTENSION = '["bmp","gif","jpg","jpeg","png","doc","docx","xls","xlsx","ppt","pptx","html","htm","txt","rar","zip","gz","bz2","mp4","avi","rmvb","pdf"]'
# 下载文件存放的本地根目录
DOWNLOAD_PATH = 'vf_admin/download_path'

# ================ Stream topic 配置 ================ 
# 消费组ID
group_id= 'knowledge_content'
# 文档解析待处理队列
document_parse_pending = 'document.parse.pending'
# 文档 Markdown 合并待处理队列
document_md_pending = 'document.md.pending'
# 爬取任务执行队列
crawl_task_pending = 'crawl.task.pending'
# 爬取文档持久化（合并 Markdown 并落库）
crawl_document_pending = 'crawl.document.pending'

# ================ 分布式信号量配置 ================
# 爬取流水线令牌池大小（DistributedSemaphore.create_pool size）
# 对应 SemaphoreKey.crawl_pipeline_key()
SEMAPHORE_CRAWL_PIPELINE_SIZE = 10